<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template id="portfolio_home_page" name="Portfolio Game" >
        <t t-call="website.layout">
            <owl-component name="web_portfolio_dev.PortfolioGame"/>
        </t>
    </template>


    <record id="portfolio_home_page_record" model="website.page">
    <field name="name">Portfolio</field>
    <field name="url">/portfolio</field>
    <field name="view_id" ref="portfolio_home_page"/>
    <field name="is_published">True</field>
</record>
</odoo>