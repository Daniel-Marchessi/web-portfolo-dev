<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_portfolio_dev.PortfolioGame">
        <div class="portfolio-page">
            <div t-if="!state.loaderGone"
                 class="portfolio-loader"
                 t-att-class="{'portfolio-loader--hidden': !state.loading}"
                 aria-hidden="true">
    <div class="portfolio-loader__inner">
        <span class="portfolio-loader__name">Daniel Marchessi</span>
        <span class="portfolio-loader__bar"><i/></span>
        <div class="portfolio-loader__tech" t-key="state.techIndex">
            <span class="portfolio-loader__badge"
                  t-att-style="'--tech-bg:' + currentTech.color + ';--tech-fg:' + currentTech.text"
                  t-out="currentTech.short"/>
            <small t-out="currentTech.label"/>
        </div>
    </div>
</div>
            <section class="portfolio-game">

                <main class="portfolio-game__content">
                    <div class="portfolio-game__cols">
                        <div class="portfolio-game__col portfolio-game__col--text">
                            <p class="portfolio-game__available">
                                <i/>
                                Available for new opportunities
                            </p>

                            <h1>
                                Daniel Marchessi
                                <span class="portfolio-game__role"
                                      t-key="state.roleIndex"
                                      t-out="roles[state.roleIndex]"/>
                            </h1>

                            <p class="portfolio-game__description">
                                I build business software, custom Odoo modules, and integrations
                                that turn complex requirements into practical solutions.
                            </p>
                        </div>

                        <div class="portfolio-game__col portfolio-game__col--info">
                            <p class="portfolio-game__label">What I do</p>
                            <ul class="portfolio-game__list">
                                <li>Custom Odoo modules</li>
                                <li>Integrations and APIs</li>
                                <li>Website and portals</li>
                                <li>Workflow automation</li>
                            </ul>

                            <div class="portfolio-game__stats">
                                <div>
                                    <strong>4+</strong>
                                    <span>Years of experience</span>
                                </div>
                            </div>

                            <p class="portfolio-game__location">
                                Based in Argentina · Working worldwide
                            </p>
                        </div>
                    </div>
                </main>
            </section>

            <section class="portfolio-exp" id="experience">
                <h2 class="portfolio-exp__title">Experience</h2>

                <t t-foreach="experience" t-as="job" t-key="job_index">
                    <article class="portfolio-exp__item">
                        <h3 class="portfolio-exp__company" t-out="job.company"/>

                        <div class="portfolio-exp__role">
                            <p class="portfolio-exp__position" t-out="job.role"/>
                            <p class="portfolio-exp__period" t-out="job.period"/>
                        </div>

                        <div class="portfolio-exp__details">
                            <p class="portfolio-exp__description" t-out="job.description"/>
                            <p class="portfolio-exp__location" t-out="job.location"/>
                        </div>
                    </article>
                </t>
            </section>

            <section class="portfolio-projects" id="projects">
                <h2 class="portfolio-projects__title">Projects</h2>

                <div class="portfolio-projects__grid">
                    <t t-foreach="projects" t-as="project" t-key="project.id">
                        <article class="portfolio-projects__card">
                            <div class="portfolio-projects__head">
                                <h3 class="portfolio-projects__name">
                                    <i class="portfolio-projects__dot"/>
                                    <t t-out="project.name"/>
                                </h3>
                                <span t-if="project.status"
                                      class="portfolio-projects__badge"
                                      t-out="project.status"/>
                            </div>

                            <p class="portfolio-projects__lang">
                                <i t-att-style="'background:' + project.langColor"/>
                                <t t-out="project.language"/>
                            </p>

                            <p class="portfolio-projects__description" t-out="project.description"/>

                            <ul class="portfolio-projects__tags">
                                <t t-foreach="project.tags" t-as="tag" t-key="tag">
                                    <li t-out="tag"/>
                                </t>
                            </ul>

                            <a t-if="project.url"
                               class="portfolio-projects__link"
                               t-att-href="project.url"
                               target="_blank"
                               rel="noopener noreferrer">
                                View project →
                            </a>
                        </article>
                    </t>
                </div>
            </section>

        </div>
    </t>
</templates>